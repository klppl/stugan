# syntax=docker/dockerfile:1

# stugan-engine: the optional sidecar that keeps IRC connected while stugan
# restarts. Built alone (no web client, no SQLite) so its image only changes
# when the engine does — see docs/engine.md for why that matters.

FROM --platform=$BUILDPLATFORM golang:1.26-alpine AS build
ARG TARGETOS
ARG TARGETARCH
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY cmd/stugan-engine/ ./cmd/stugan-engine/
COPY internal/engine/ ./internal/engine/
COPY internal/engineproto/ ./internal/engineproto/
COPY internal/logging/ ./internal/logging/
RUN CGO_ENABLED=0 GOOS=${TARGETOS} GOARCH=${TARGETARCH} \
    go build -ldflags "-s -w -X main.buildVersion=docker" -o /out/stugan-engine ./cmd/stugan-engine

FROM alpine:3.20
# CA certificates are required to verify IRC servers' TLS certificates.
RUN apk add --no-cache ca-certificates && adduser -D -u 10001 stugan
COPY --from=build /out/stugan-engine /app/stugan-engine
# No volume: the engine holds no data. Set STUGAN_ENGINE_SECRET, and
# STUGAN_ENGINE_LISTEN=0.0.0.0:8016 in a container (loopback is unreachable
# from the stugan container).
EXPOSE 8016
USER stugan
HEALTHCHECK --interval=10s --timeout=3s --start-period=5s --retries=3 \
    CMD ["/app/stugan-engine", "-health"]
ENTRYPOINT ["/app/stugan-engine"]
